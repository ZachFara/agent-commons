{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/agent-commons/**)",
      "Edit(~/.config/agent-commons/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(claude_ai_Linear|linear)__.*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/linear_guard.sh", "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash_guard.sh", "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(claude_ai_Linear|linear)__save_issue",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record_issue.sh", "onFailure": "block" }
        ]
      }
    ]
  }
}
