        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(pg_up)",
          "legendFormat": "__auto",
          "exemplar": false,
          "refId": "A"
