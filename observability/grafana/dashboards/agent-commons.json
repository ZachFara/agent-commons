      "description": "invalid_input and rate_limited are the caller's; internal is ours.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (gen_ai_tool_name, error_type) (rate(commons_tool_call_duration_count{job=~\"$job\", error_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_tool_name}}: {{error_type}}",
          "exemplar": false,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "traces",
      "title": "Recent tool calls (traces)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Each row is one tool call; open it to see the SQL beneath and jump to its log lines.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "query": "{ span.gen_ai.tool.name != \"\" && resource.service.name =~ \"$job\" } | select(span.commons.task_id, span.commons.model, span.commons.error)"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 17,
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Application log",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Call-log lines (decision 0024) and warnings from the app. Expand a line and follow its trace id into Tempo.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=~\"$job\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 19,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      }
    }
  ]
}
