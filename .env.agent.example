# Environment for agent sessions. Copy to .env.agent (gitignored; .worktreeinclude copies it
# into every agent worktree) and load it in each shell: set -a; . ./.env.agent; set +a
#
# Every URL here is the local throwaway Postgres from db/compose.yml (`make db`), never the
# live Commons database. scripts/test-db.sh refuses any host but localhost.

# Admin connection the tests and scripts/test-db.sh create throwaway databases from.
COMMONS_TEST_DATABASE_URL=postgresql://commons:commons@localhost:5432/commons
# The database `uv run commons ...` uses. scripts/test-db.sh replaces it with a fresh one.
COMMONS_DATABASE_URL=postgresql://commons:commons@localhost:5432/commons_agent
# Keep the CLI and hooks off this machine's real identity and hosted-server key.
COMMONS_CONFIG=.scratch/agent/config.json
COMMONS_STATE_DIR=.scratch/agent/state
